# Copy to .env for local builds (.env is gitignored; CI uses the built-in token).
#
# Without a token, scripts/fetch-repos.js uses the unauthenticated GitHub API,
# which allows only 60 requests/hour. When that limit is hit the build silently
# falls back to scraping the repo HTML page, which cannot report a repository's
# language — that is what turns project cards into "Language: Unknown".
#
# Create a fine-grained token with *no* scopes (public read is enough):
#   https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Owner used to resolve bare repo ids in config/projects.yaml (ids written as
# "owner/repo" do not need this).
GITHUB_USERNAME=nstathou
